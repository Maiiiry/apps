{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["go.mod", "go.sum", "protos/**"],
  "tasks": {
    "build": {
      "outputs": ["dist/**"]
    },
    "build:frontend": {
      "outputs": ["dist/**"]
    },
    "test": {
      "cache": false
    },
    "ci:format": {
      "cache": false
    },
    "ci:vet": {
      "cache": false
    },
    "ci:build": {
      "cache": false
    },
    "ci:unit": {
      "cache": false
    },
    "ci:integration": {
      "cache": false
    },
    "ci:oci": {
      "cache": false
    }
  }
}
